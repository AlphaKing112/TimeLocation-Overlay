{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timelocation-overlay",
  "main": "worker.js",
  "compatibility_date": "2024-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
