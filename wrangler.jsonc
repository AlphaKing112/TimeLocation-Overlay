{
  "name": "timelocation-overlay",
  "main": "worker.js",
  "compatibility_date": "2024-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "OVERLAY_KV",
      "id": "2c095a9fdff4433cb9e4b11f822623da"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
